{
  "name": "hoyolab-auto-dailyclaim",
  "version": "2.0.0",
  "description": "Automated, lightweight, and secure HoYoLAB daily check-in rewards claimer for Genshin Impact, Honkai: Star Rail, Zenless Zone Zero, Honkai Impact 3rd, and Tears of Themis.",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dry-run": "node --env-file-if-exists=.env src/index.ts --dry-run",
    "validate": "node --env-file-if-exists=.env src/index.ts --validate"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "hoyolab",
    "daily-checkin",
    "genshin-impact",
    "honkai-star-rail",
    "zenless-zone-zero",
    "honkai-impact-3rd",
    "tears-of-themis",
    "nodejs",
    "pnpm",
    "automation"
  ],
  "license": "MIT"
}
